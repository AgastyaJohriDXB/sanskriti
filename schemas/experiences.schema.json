{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["places"],
  "properties": {
    "places": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "name", "city", "type", "skills", "categories", "description", "url", "verified"],
      "properties": {
        "type": {"enum": ["workshop", "class", "museum", "cooperative", "festival"]},
        "url": {"type": "string", "pattern": "^https://"},
        "verified": {"type": "object", "required": ["date", "source"], "properties": {"date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}}
      }}}
  }
}
