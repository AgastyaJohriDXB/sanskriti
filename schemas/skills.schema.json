{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["categories", "skills"],
  "properties": {
    "categories": {"type": "array", "minItems": 6, "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}}},
    "skills": {"type": "array", "minItems": 12, "items": {
      "type": "object",
      "required": ["id", "name", "category", "zone", "regions", "blurb", "history", "practisedBy", "techniqueSteps", "whyItMatters", "image", "sources", "learnMore", "quizWeights"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "category": {"enum": ["arts", "crafts", "textiles", "music", "dance", "food"]},
        "zone": {"enum": ["north", "south", "east", "west", "central"]},
        "regions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "techniqueSteps": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "image": {"type": "object", "required": ["src", "alt", "credit", "licence"], "properties": {"src": {"type": "string", "pattern": "^assets/img/"}, "alt": {"type": "string", "minLength": 10}}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "url"], "properties": {"url": {"type": "string", "pattern": "^https://"}}}},
        "learnMore": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "url"], "properties": {"url": {"type": "string", "pattern": "^https://"}}}},
        "quizWeights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
      }}}
  }
}
